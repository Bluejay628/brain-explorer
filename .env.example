# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# These variables are read ONLY by the server (server/config.ts). They are never sent to the browser.

# Claude API key for the AI research engine. Get one at https://console.anthropic.com/
# Leave blank to run in "retrieval-only" mode (search works, no AI synthesis).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
CLAUDE_MODEL=

# NCBI E-utilities (PubMed). An API key is optional but raises the rate limit
# from 3 to 10 requests/second. Get one in your NCBI account settings:
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# NCBI asks every tool to identify itself with a contact email.
NCBI_EMAIL=
NCBI_TOOL=brain-explorer

# Other research databases (all free; no key needed).
# Contact email for OpenAlex's "polite pool" (faster, more reliable). Falls back to NCBI_EMAIL.
CONTACT_EMAIL=
# Optional Semantic Scholar key — without it, requests share a public rate limit and may be slow.
# Request one at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Server port (default 8787)
PORT=
